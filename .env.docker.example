# Copy this file to .env.docker and fill in real values.
# docker-compose reads this automatically: `docker compose --env-file .env.docker up`
# Or rename to .env (default lookup) — recommended.

# ---------------------------------------------------------------------------
# Symfony
# ---------------------------------------------------------------------------
APP_ENV=dev
# Generate with: openssl rand -hex 32
APP_SECRET=CAMBIA_ESTO_POR_UN_HEX_DE_32_BYTES

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_DB=rcm
POSTGRES_USER=rcm
POSTGRES_PASSWORD=cambia_esta_password
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Mailer (Gmail con App Password)
# ---------------------------------------------------------------------------
# 1. Activa 2FA en la cuenta Gmail.
# 2. Genera una App Password de 16 caracteres en https://myaccount.google.com/apppasswords
# 3. Pegala abajo SIN espacios.
# DSN: smtp://USUARIO@gmail.com:APP_PASSWORD@smtp.gmail.com:587
MAILER_DSN=smtp://CAMBIA_USUARIO@gmail.com:CAMBIA_APP_PASSWORD@smtp.gmail.com:587
MAILER_FROM="RCM <CAMBIA_USUARIO@gmail.com>"

# ---------------------------------------------------------------------------
# Puertos host
# ---------------------------------------------------------------------------
NGINX_PORT=8080
VITE_PORT=5173

# ---------------------------------------------------------------------------
# Auto-cleanup de almacenamiento (en bytes)
# Cuando el total (tablas BD + uploads en disco) supera STORAGE_THRESHOLD_BYTES,
# se borran los jobs más antiguos no-activos hasta volver a STORAGE_TARGET_BYTES.
# Defaults: 10 GB / 5 GB
# ---------------------------------------------------------------------------
STORAGE_THRESHOLD_BYTES=10737418240
STORAGE_TARGET_BYTES=5368709120

{% extends 'emails/_layout.html.twig' %}

{% block title %}Solicitud de registro - RCM{% endblock %}
{% block headerSubtitle %}Aprobación pendiente{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:22px; font-weight:600; color:#0f172a;">
        Nueva solicitud de registro
    </h1>

    <p style="margin:0 0 16px; color:#334155;">
        Una persona se registró en RCM y necesita tu aprobación para poder iniciar sesión.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:24px 0; background:#eff6ff; border:1px solid #bfdbfe; border-radius:10px;">
        <tr>
            <td style="padding:18px 20px;">
                <div style="font-size:13px; color:#475569; margin-bottom:6px;">Solicitante</div>
                <div style="font-size:16px; font-weight:600; color:#0f172a;">{{ applicant.displayName }}</div>
                <div style="font-size:14px; color:#334155; margin-top:6px;">{{ applicant.email }}</div>
                <div style="font-size:12px; color:#64748b; margin-top:6px;">Registrado el {{ applicant.createdAt|date('d/m/Y H:i') }}</div>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 8px;">
        <tr>
            <td style="border-radius:10px; background:#15803d;">
                <a href="{{ approveUrl }}"
                   style="display:inline-block; padding:13px 24px; font-size:14px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;">
                    Aprobar
                </a>
            </td>
            <td style="width:14px;"></td>
            <td style="border-radius:10px; background:#9f1239;">
                <a href="{{ rejectUrl }}"
                   style="display:inline-block; padding:13px 24px; font-size:14px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;">
                    Rechazar
                </a>
            </td>
        </tr>
    </table>

    <p style="margin:24px 0 0; color:#64748b; font-size:13px;">
        También puedes gestionar este registro desde la vista <strong>Usuarios</strong> en la plataforma.
    </p>
{% endblock %}

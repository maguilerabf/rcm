{% extends 'emails/_layout.html.twig' %}

{% block title %}Bienvenido a RCM{% endblock %}
{% block headerSubtitle %}Tu cuenta está lista{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:22px; font-weight:600; color:#0f172a; letter-spacing:-0.01em;">
        ¡Hola, {{ displayName }}!
    </h1>

    <p style="margin:0 0 16px; color:#334155;">
        Te damos la bienvenida a <strong>RCM</strong>. Tu cuenta fue creada con éxito y ya puedes ingresar al sistema.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:24px 0;">
        <tr>
            <td style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:16px 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="font-size:12px; color:#64748b; padding-bottom:6px; text-transform:uppercase; letter-spacing:0.04em;">Email de acceso</td>
                    </tr>
                    <tr>
                        <td style="font-size:14px; color:#0f172a; font-weight:500; word-break:break-all;">{{ recipientEmail }}</td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:8px 0 24px;">
        <tr>
            <td style="border-radius:10px; background:#1d4ed8;">
                <a href="{{ loginUrl }}"
                   style="display:inline-block; padding:13px 24px; font-size:14px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;">
                    Ingresar a RCM
                </a>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 8px; color:#64748b; font-size:13px;">
        Por seguridad, no compartas tus credenciales y cambia tu contraseña periódicamente.
    </p>

    <p style="margin:24px 0 0; color:#334155;">
        Saludos,<br>
        <span style="color:#64748b;">Equipo RCM</span>
    </p>
{% endblock %}

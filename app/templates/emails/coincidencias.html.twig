{% extends 'emails/_layout.html.twig' %}

{% block title %}Coincidencias - Identificación Sectores{% endblock %}
{% block headerSubtitle %}Cruce Telesalud × Inscritos{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:20px; font-weight:600; color:#0f172a; letter-spacing:-0.01em;">
        Coincidencias listas
    </h1>

    <p style="margin:0 0 16px; color:#334155;">
        Te adjuntamos el archivo Excel con las coincidencias del cruce entre el <strong>Reporte Telesalud</strong> y el <strong>Padrón de Inscritos</strong>.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:24px 0;">
        <tr>
            <td style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:10px; padding:18px 20px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="padding-bottom:10px;">
                            <div style="font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:4px;">Total de filas</div>
                            <div style="font-size:24px; color:#0f172a; font-weight:700; font-variant-numeric:tabular-nums;">{{ rows|number_format(0, ',', '.') }}</div>
                        </td>
                    </tr>
                    {% if sector %}
                    <tr>
                        <td style="border-top:1px solid #e2e8f0; padding-top:10px;">
                            <div style="font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:4px;">Sector filtrado</div>
                            <div style="font-size:14px; color:#0f172a; font-weight:600;">{{ sector }}</div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td style="border-top:1px solid #e2e8f0; padding-top:10px;">
                            <div style="font-size:11px; color:#64748b; text-transform:uppercase; letter-spacing:0.04em; margin-bottom:4px;">Filtro</div>
                            <div style="font-size:14px; color:#0f172a; font-weight:500;">Todos los sectores</div>
                        </td>
                    </tr>
                    {% endif %}
                </table>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 8px; color:#64748b; font-size:13px;">
        El archivo viene con coloreo por sector para facilitar la lectura. Revisa el adjunto al pie de este correo.
    </p>

    {% if customBody %}
        <div style="margin:24px 0 0; padding:16px 18px; background:#fefce8; border:1px solid #fde68a; border-radius:10px; color:#713f12; font-size:13px;">
            {{ customBody|nl2br }}
        </div>
    {% endif %}

    <p style="margin:24px 0 0; color:#334155;">
        Saludos,<br>
        <span style="color:#64748b;">Equipo RCM</span>
    </p>
{% endblock %}

{% block footerExtra %} Generado automáticamente desde el módulo Identificación Sectores.{% endblock %}

{% extends 'emails/_layout.html.twig' %}

{% block title %}Restablecer contraseña - RCM{% endblock %}
{% block headerSubtitle %}Recuperación de acceso{% endblock %}

{% block content %}
    <h1 style="margin:0 0 16px; font-size:22px; font-weight:600; color:#0f172a; letter-spacing:-0.01em;">
        Hola, {{ displayName }}
    </h1>

    <p style="margin:0 0 16px; color:#334155;">
        Recibimos una solicitud para restablecer la contraseña asociada a <strong>{{ recipientEmail }}</strong> en RCM.
        Si fuiste tú, haz clic en el botón de abajo para definir una nueva contraseña.
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin:24px 0 8px;">
        <tr>
            <td style="border-radius:10px; background:#1d4ed8;">
                <a href="{{ resetUrl }}"
                   style="display:inline-block; padding:13px 28px; font-size:14px; font-weight:600; color:#ffffff; text-decoration:none; border-radius:10px;">
                    Restablecer contraseña
                </a>
            </td>
        </tr>
    </table>

    <p style="margin:8px 0 24px; font-size:12px; color:#94a3b8;">
        ¿El botón no funciona? Copia y pega este enlace en tu navegador:<br>
        <span style="color:#475569; word-break:break-all; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;">{{ resetUrl }}</span>
    </p>

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="margin:24px 0;">
        <tr>
            <td style="background:#fef3c7; border:1px solid #fde68a; border-radius:10px; padding:14px 16px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                    <tr>
                        <td style="vertical-align:top; padding-right:10px;">
                            <span style="display:inline-block; width:22px; height:22px; line-height:22px; text-align:center; border-radius:999px; background:#f59e0b; color:#fff; font-weight:700; font-size:13px;">!</span>
                        </td>
                        <td style="font-size:13px; color:#713f12; line-height:1.5;">
                            <strong>Este enlace expira en {{ expiresInText }}</strong> (a las {{ expiresAt|date('H:i') }} del {{ expiresAt|date('d/m/Y') }}).
                            Por seguridad solo puede usarse una vez.
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <p style="margin:0 0 8px; color:#64748b; font-size:13px;">
        Si <strong>no fuiste tú</strong> quien pidió restablecer la contraseña, puedes ignorar este correo.
        Tu contraseña no cambia hasta que abras el enlace y elijas una nueva.
    </p>

    <p style="margin:24px 0 0; color:#334155;">
        Saludos,<br>
        <span style="color:#64748b;">Equipo RCM</span>
    </p>
{% endblock %}

{% block footerExtra %} Si no reconoces esta solicitud, ignora este correo o avísanos.{% endblock %}

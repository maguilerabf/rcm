# Producción — copiar a app/.env.local en el servidor.
# NUNCA commitear este archivo con valores reales.

APP_ENV=prod
APP_DEBUG=0

# openssl rand -hex 32
APP_SECRET=GENERA_UN_SECRET_DE_64_HEX

# Postgres local (mismo host, sin Docker)
DATABASE_URL="postgresql://rcm:CAMBIA_DB_PASSWORD@127.0.0.1:5432/rcm?serverVersion=16&charset=utf8"

# Gmail con App Password (16 chars, sin espacios). El @ del email se URL-encodea como %40.
MAILER_DSN=smtp://USUARIO%40gmail.com:APP_PASSWORD@smtp.gmail.com:587
MAILER_FROM="RCM <USUARIO@gmail.com>"

# Messenger en la misma BD (cola Doctrine)
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0

# Detrás de Caddy (proxy local)
TRUSTED_PROXIES=127.0.0.1,::1

# Auto-cleanup almacenamiento
STORAGE_THRESHOLD_BYTES=10737418240   # 10 GB
STORAGE_TARGET_BYTES=5368709120       # 5 GB
